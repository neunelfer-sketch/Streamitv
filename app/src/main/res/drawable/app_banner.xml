<?xml version="1.0" encoding="utf-8"?>
<!--
  TV-Banner für Android 5 und 6 – dieselbe Bildmarke wie in `drawable-v24/`,
  nur in Volltonfarben. Begründung siehe `mipmap/ic_launcher.xml`:
  Farbverläufe in Vektorgrafiken gibt es erst ab API 24, darunter bliebe die
  Fläche leer.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- Dunkle Fläche -->
    <path
        android:fillColor="#24242E"
        android:pathData="M0,0h320v180h-320z" />

    <!-- Ring des Q -->
    <path
        android:strokeColor="#A78BFA"
        android:strokeWidth="18"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M119,80 A31,31 0 1,0 181,80 A31,31 0 1,0 119,80" />

    <!-- Schwanz des Q -->
    <path
        android:strokeColor="#A78BFA"
        android:strokeWidth="18"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M165,98 L183,116" />

    <!-- Dunkler Ring um den Play-Knopf -->
    <path
        android:fillColor="#24242E"
        android:pathData="M192,122 m-29,0 a29,29 0 1,0 58,0 a29,29 0 1,0 -58,0 Z" />

    <!-- Play-Knopf -->
    <path
        android:fillColor="#C4B5FD"
        android:pathData="M192,122 m-23,0 a23,23 0 1,0 46,0 a23,23 0 1,0 -46,0 Z" />

    <!-- Dreieck, aus dem Knopf ausgespart -->
    <path
        android:fillColor="#24242E"
        android:pathData="M186,111 L208,122 L186,134 Z" />
</vector>
