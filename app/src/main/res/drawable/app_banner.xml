<?xml version="1.0" encoding="utf-8"?>
<!-- TV-Banner (320x180 dp) für den Leanback-Launcher, im "Liquid Glass"-Stil
     passend zum App-Icon: heller blauer Grund, Glas-Tiefe/-Glanz, weißes "Q". -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- Grundfarbe: leicht blauer Hintergrund -->
    <path
        android:fillColor="#79C2F2"
        android:pathData="M0,0h320v180h-320z" />

    <!-- Tiefe: abgedunkelter Streifen am unteren Rand -->
    <path
        android:fillColor="#332B5A9E"
        android:pathData="M0,120 L320,120 L320,180 L0,180 Z" />

    <!-- Glasglanz: diagonaler heller Streifen -->
    <path
        android:fillColor="#4DFFFFFF"
        android:pathData="M-20,60 L110,-20 L160,-20 L30,80 Z" />

    <!-- Glanzpunkt oben links -->
    <path
        android:fillColor="#59FFFFFF"
        android:pathData="M64,46 m-16,0 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0 Z" />

    <!-- "Q"-Schriftzug: Ring plus Schwanz -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="15"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M126,85 A34,34 0 1,0 194,85 A34,34 0 1,0 126,85" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="15"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M184,109 L210,135" />
</vector>
