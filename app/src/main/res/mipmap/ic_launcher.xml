<?xml version="1.0" encoding="utf-8"?>
<!--
  App-Icon für Android 5 und 6.

  Dieselbe Zeichnung wie in `mipmap-v24/`, nur in Volltonfarben:
  Farbverläufe in Vektorgrafiken gibt es erst ab API 24. Auf einem Fire TV
  Stick der 2. Generation (Fire OS 5, Android 5.1) bliebe eine
  Verlaufsfüllung sonst einfach leer – ein schwarzes Icon wäre das Ergebnis.

  Der Verlauf wird hier nicht nachgebaut, sondern durch je einen mittleren
  Farbton ersetzt. Auf den Geräten, um die es geht, steht das Icon ohnehin
  klein in einer Kachelreihe; ein Verlauf wäre dort nicht zu erkennen, eine
  falsche Farbe dagegen schon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Dunkle Kachel mit weichen Ecken -->
    <path
        android:fillColor="#24242E"
        android:pathData="M27,0 L81,0 A27,27 0 0,1 108,27 L108,81 A27,27 0 0,1 81,108 L27,108 A27,27 0 0,1 0,81 L0,27 A27,27 0 0,1 27,0 Z" />

    <!-- Ring des Q -->
    <path
        android:strokeColor="#A78BFA"
        android:strokeWidth="14"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M22,46 A24,24 0 1,0 70,46 A24,24 0 1,0 22,46" />

    <!-- Schwanz des Q -->
    <path
        android:strokeColor="#A78BFA"
        android:strokeWidth="14"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M58,60 L72,74" />

    <!-- Dunkler Ring um den Play-Knopf -->
    <path
        android:fillColor="#24242E"
        android:pathData="M79,79 m-22,0 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0 Z" />

    <!-- Play-Knopf -->
    <path
        android:fillColor="#C4B5FD"
        android:pathData="M79,79 m-18,0 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0 Z" />

    <!-- Dreieck, aus dem Knopf ausgespart -->
    <path
        android:fillColor="#24242E"
        android:pathData="M74,70 L91,79 L74,88 Z" />
</vector>
