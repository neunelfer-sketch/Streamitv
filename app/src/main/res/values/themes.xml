<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Basis-Theme: bewusst ohne ActionBar und mit dunklem Hintergrund,
      damit beim App-Start kein weißer Blitz auf dem TV entsteht.
      Das eigentliche Design wird in Compose (ui/theme) definiert.
    -->
    <style name="Theme.XottPlayer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/tv_background</item>
        <item name="android:colorBackground">@color/tv_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActivityTransitions">true</item>
    </style>
</resources>
